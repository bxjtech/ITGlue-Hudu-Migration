# Copy to .env and fill in. Never commit .env.
HUDU_BASE_URL=https://yourcompany.huducloud.com
HUDU_API_KEY=

# https://api.itglue.com (US), https://api.eu.itglue.com (EU), https://api.au.itglue.com (AU)
ITGLUE_API_URL=https://api.itglue.com
ITGLUE_API_KEY=

# Host folder holding the unzipped IT Glue export (optional for the companies stage).
ITGLUE_EXPORT_HOST_PATH=./export
